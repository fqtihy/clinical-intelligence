# .env dosyasını kopyalayıp gerçek değerleri girin

# ---- Aktif model sağlayıcısı ----
# 'deepseek' | 'openai' | 'mock'
# Provider değiştirmek için yalnızca bu satır + ilgili anahtar yeterlidir.
# Güvenli varsayılan: anahtar olmadan yerel demo/test çalışır.
MODEL_PROVIDER=mock

# ---- Provider-bağımsız ortak model ayarları ----
# Tüm provider'lar için geçerlidir; eski provider'a özel değişkenler
# (DEEPSEEK_TIMEOUT_MS vb.) geriye dönük uyumluluk için fallback olarak kabul edilir.
#MODEL_TIMEOUT_MS=120000
#MODEL_MAX_TOKENS=8192
#MODEL_TEMPERATURE=0.3

# ---- DeepSeek (isteğe bağlı canlı provider) ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI-uyumlu alternatif (MODEL_PROVIDER=openai iken) ----
# OpenAI, Azure OpenAI, vLLM, Ollama vb. tüm OpenAI-uyumlu uçları bağlayabilir.
#OPENAI_API_KEY=sk-your-key-here
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# ---- Prompt sürümü (prompt engineering modülü) ----
# server/prompts/versions.js kayıt defterindeki sürümlerden biri: '1.0' | '1.1' | '2.0'.
# Analiz sonuçları bu sürümü prompt_version olarak taşır; sürümler arası kalite
# karşılaştırması (A/B) için kullanılır. Boş bırakılırsa en güncül stable sürüm kullanılır.
#PROMPT_VERSION=2.0

# ---- Sunucu ----
PORT=3000
